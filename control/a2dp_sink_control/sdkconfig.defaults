# Bluetooth defaults from ESP-IDF v6.1 a2dp_sink_stream/sdkconfig.defaults.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_BLE_ENABLED=n

# Use the same internal SBC decoder / PCM callback as the example's default.
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=n

# UART console; retain normal INFO logs and the default Bluetooth warnings.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Match the DOIT ESP32 DEVKIT V1 board's 4 MB flash declaration.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
